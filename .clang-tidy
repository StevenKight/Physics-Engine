---
# Scope: the C sources under src/ and test/ (CUDA .cu files are parsed as C++
# by clang-tidy's driver, so the same checks apply reasonably well there too).
# Fortran has no clang-tidy support and is excluded implicitly.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -readability-isolate-declaration

WarningsAsErrors: ''

HeaderFilterRegex: '^(src|test)/.*'

FormatStyle: file

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '35'
