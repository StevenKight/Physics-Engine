root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h,cu,cuh}]
indent_size = 4

[*.{f90,F90,f,F}]
indent_size = 2

[*.py]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
